# ===== Server =====
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins (frontend URL).
CORS_ORIGINS=http://localhost:5173

# ===== Storage =====
# Inside the backend container, data lives at /data (persisted via a volume).
DATA_DIR=/data
MAX_FILE_SIZE_MB=50

# ===== OCR =====
# Default Tesseract language. Combine with '+', e.g. fra+eng.
TESSERACT_LANG=fra
OCR_DPI=300
MAX_WORKERS=2
ENABLE_PREPROCESSING=true

# ===== Frontend (build-time) =====
# URL the browser uses to reach the API. Baked into the frontend bundle.
VITE_API_URL=http://localhost:8000
