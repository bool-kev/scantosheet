# ===== Server =====
HOST=0.0.0.0
PORT=8082
# Comma-separated list of allowed CORS origins. Add every browser app that
# calls the API, e.g. http://localhost:8081,https://app.example.com
CORS_ORIGINS=http://localhost:8081
# Optional regex for origins an explicit list cannot cover (preview deploys):
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# ===== Storage =====
# Inside the backend container, data lives at /data (persisted via a volume).
DATA_DIR=/data
MAX_FILE_SIZE_MB=50

# ===== OCR =====
# Default Tesseract language. Combine with '+', e.g. fra+eng.
TESSERACT_LANG=fra
OCR_DPI=300
MAX_WORKERS=2
ENABLE_PREPROCESSING=true
# Extract only data inside detected tables; ignore text before/after them.
EXTRACT_TABLES_ONLY=true

# ===== Images -> PDF module =====
# Per-image upload size limit and max number of images per batch.
MAX_IMAGE_SIZE_MB=20
MAX_BATCH_IMAGES=200

# ===== Authentication =====
# Controls the DOCUMENT endpoints (/api/documents).
#   true (default): closed — every call requires an X-API-Key header, so a
#     guest on the network cannot create or read data.
#   false: open — the web UI can import and browse without a key. Only use
#     this on a fully trusted, isolated network.
# Key administration (/api/admin) is ALWAYS authenticated, whatever this is set to.
AUTH_ENABLED=true

# Administrator key. Required to reach /api/admin and manage keys — without it
# the admin API answers 503. Generate one with:
#   python -c "import secrets; print('sts_root_' + secrets.token_hex(24))"
ADMIN_API_KEY=

# ===== Webhooks (callback instead of polling) =====
# Absolute base URL used to build the links sent in webhook payloads. The server
# cannot infer how it is reached from behind a reverse proxy — set it explicitly.
PUBLIC_BASE_URL=http://localhost:8082
# Shared secret used to sign webhook bodies (HMAC-SHA256). Without it the
# receiver cannot verify the callback really came from this server.
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3

# ===== Frontend (build-time) =====
# URL the browser uses to reach the API. Baked into the frontend bundle.
VITE_API_URL=http://localhost:8082
# API key baked into the frontend bundle so end users never see a login
# screen: the app authenticates every request with this single shared
# identity. Mint it with a 'user' role (NOT 'admin') via:
#   curl -X POST $VITE_API_URL/api/admin/keys \
#        -H "X-API-Key: $ADMIN_API_KEY" \
#        -H "Content-Type: application/json" \
#        -d '{"label": "frontend", "role": "user"}'
# Required once AUTH_ENABLED=true, otherwise every request from the web UI
# gets a 401. Rebuild the frontend image after changing this value.
VITE_API_KEY=
