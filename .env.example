# ===== Server =====
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins. Add every browser app that
# calls the API, e.g. http://localhost:5173,https://app.example.com
CORS_ORIGINS=http://localhost:5173
# Optional regex for origins an explicit list cannot cover (preview deploys):
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# ===== Storage =====
# Inside the backend container, data lives at /data (persisted via a volume).
DATA_DIR=/data
MAX_FILE_SIZE_MB=50

# ===== OCR =====
# Default Tesseract language. Combine with '+', e.g. fra+eng.
TESSERACT_LANG=fra
OCR_DPI=300
MAX_WORKERS=2
ENABLE_PREPROCESSING=true
# Extract only data inside detected tables; ignore text before/after them.
EXTRACT_TABLES_ONLY=true

# ===== Authentication =====
# Controls the DOCUMENT endpoints only (/api/documents).
#   false (default): open — the web UI can import and browse without a key.
#   true: every /api/documents call requires an X-API-Key header.
# Key administration (/api/admin) is ALWAYS authenticated, whatever this is set to.
AUTH_ENABLED=false

# Administrator key. Required to reach /api/admin and manage keys — without it
# the admin API answers 503. Generate one with:
#   python -c "import secrets; print('sts_root_' + secrets.token_hex(24))"
ADMIN_API_KEY=

# ===== Webhooks (callback instead of polling) =====
# Absolute base URL used to build the links sent in webhook payloads. The server
# cannot infer how it is reached from behind a reverse proxy — set it explicitly.
PUBLIC_BASE_URL=http://localhost:8000
# Shared secret used to sign webhook bodies (HMAC-SHA256). Without it the
# receiver cannot verify the callback really came from this server.
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3

# ===== Frontend (build-time) =====
# URL the browser uses to reach the API. Baked into the frontend bundle.
VITE_API_URL=http://localhost:8000
